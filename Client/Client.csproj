<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <StaticWebAssetSpaFallbackEnabled>true</StaticWebAssetSpaFallbackEnabled>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Enable runtime size optimizations when wasm-tools is installed. -->
  <PropertyGroup Condition="'$(WASM_TOOLS_INSTALLED)' == 'true'">
    <InvariantTimezone>true</InvariantTimezone>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Gateway" />
    <ProjectReference Include="..\Storyblok\Storyblok.csproj" />

    <!-- Keep local Storyblok tokens out of the published wwwroot. -->
    <Content Update="wwwroot\appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <Import Project="Csp.targets" />
</Project>

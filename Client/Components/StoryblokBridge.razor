@using Microsoft.Extensions.Options
@inject IOptions<StoryblokOptions> StoryblokOptions
@inject IJSRuntime Js
@inject ILogger<StoryblokBridge> Logger

@* Renders nothing. Inside the Visual Editor it loads Storyblok's bridge, which reloads the preview whenever the editor
   saves or publishes. Only the editor build can be in the editor (it alone has the preview token), so production never
   loads the bridge, and its Content Security Policy doesn't allow it either (see Csp.targets). *@

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !StoryblokOptions.Value.IsInEditor)
        {
            return;
        }

        try
        {
            await using IJSObjectReference module = await Js.InvokeAsync<IJSObjectReference>("import", "./Components/StoryblokBridge.razor.js");
            await module.InvokeVoidAsync("start");
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "The Storyblok bridge could not start, so the preview won't refresh when the editor saves.");
        }
    }
}

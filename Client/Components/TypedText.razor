@using Microsoft.JSInterop
@using Client.Interop
@implements IAsyncDisposable
@inject IJSRuntime Js
@inject ILogger<TypedText> Logger

@if (_texts.Length > 0)
{
    @* Give screen readers complete taglines. *@
    <div class="sr-only">
        @foreach (string text in _texts)
        {
            <p>@text</p>
        }
    </div>
    @* Reserve space for wrapped text and show the first tagline before JavaScript starts. *@
    <p @ref="_output" data-first="@_texts[0]" class="flex h-32 sm:h-24 w-full items-center justify-center px-8 text-center text-2xl font-bold tracking-tight text-white sm:text-3xl not-data-started:before:content-[attr(data-first)]" aria-hidden="true"></p>
}

@code {
    [Parameter]
    public IReadOnlyList<StoryblokText>? Model { get; set; }

    private ElementReference _output;
    private TypedTextInterop? _interop;
    private IReadOnlyList<StoryblokText>? _textsSource;
    private string[] _texts = [];
    private bool _textsChanged;

    // Restart only when the source list changes.
    protected override void OnParametersSet()
    {
        if (ReferenceEquals(Model, _textsSource))
        {
            return;
        }

        _textsSource = Model;
        _texts = [.. (Model ?? []).Select(text => text.Text?.Trim()).OfType<string>().Where(text => text.Length > 0)];
        _textsChanged = true;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_textsChanged)
        {
            return Task.CompletedTask;
        }

        _textsChanged = false;

        if (_texts.Length == 0)
        {
            return _interop?.StopAsync().AsTask() ?? Task.CompletedTask;
        }

        _interop ??= new TypedTextInterop(Js, Logger);
        return _interop.StartAsync(_output, _texts).AsTask();
    }

    public ValueTask DisposeAsync() => _interop?.DisposeAsync() ?? ValueTask.CompletedTask;
}

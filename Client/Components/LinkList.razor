@* A navigation landmark, so screen-reader users can jump straight to the profile links. *@
<nav aria-label="Profiles" class="w-full z-20 reveal">
    @* role="list": Safari stops announcing a list as a list once CSS removes its bullets, as Tailwind does. *@
    <ul role="list" class="flex flex-col w-full gap-y-10">
        @* Entries without a label would render as empty buttons, so they're skipped. *@
        @foreach (StoryblokLink link in Model?.Where(link => !string.IsNullOrWhiteSpace(link.Label)) ?? [])
        {
            <li @key="link" class="w-full flex justify-center">
                @if (string.IsNullOrEmpty(link.Url))
                {
                    @* An entry without a URL is plain text, not a link to the current page: dimmed, with a dashed outline,
                       but still readable (neutral-400 on the dark background is about 7:1). *@
                    <span class="w-4/5 sm:w-1/2 md:w-1/3 py-2 text-center font-bold text-neutral-400 rounded-lg outline-1 outline-dashed outline-purple-600/60">
                        <LinkIcon CssClass="@link.CssClass" />@link.Label<span class="sr-only"> (not available)</span>
                    </span>
                }
                else
                {
                    @* rel="me": these profiles belong to the person this page is about (used by Mastodon, IndieWeb and search engines).
                       Keyboard focus gets the same ring and lift as hover; the lift is only added when the visitor allows motion (motion-safe), which is more reliable than undoing it afterwards. *@
                    <a href="@link.Url" rel="me" class="group w-4/5 sm:w-1/2 md:w-1/3 py-2 text-center font-bold text-white rounded-lg ring-1 ring-purple-600 transition-all ease-in-out duration-200
                                                        hover:ring-2 hover:ring-white motion-safe:hover:scale-110
                                                        focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-white motion-safe:focus-visible:scale-110
                                                        motion-reduce:transition-none">
                        <LinkIcon CssClass="@link.CssClass" Animated="true" />@link.Label
                    </a>
                }
            </li>
        }
    </ul>
</nav>

@code {
    [Parameter]
    public IReadOnlyList<StoryblokLink>? Model { get; set; }
}

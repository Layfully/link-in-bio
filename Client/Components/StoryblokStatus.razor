@implements IDisposable
@inject NavigationManager Navigation
@inject TimeProvider Time

@* Mount the live region before adding the first loading announcement. *@
<p class="sr-only" role="status">@(Status == ContentStatus.Loading && _secondsWaiting > 0 ? LoadingHint : null)</p>

@if (Status == ContentStatus.Loading)
{
    @* Position the hint below the placeholder so it doesn't shift the layout. *@
    <div class="relative z-20 flex w-full flex-col items-center">
        @Placeholder
        <p class="absolute inset-x-0 top-full mt-8 flex items-center justify-center gap-x-3 px-8 text-center text-sm text-neutral-400" aria-hidden="true">
            <span class="inline-flex gap-x-1">
                <span class="h-1.5 w-1.5 rounded-full bg-purple-400 animate-bounce motion-reduce:animate-none"></span>
                <span class="h-1.5 w-1.5 rounded-full bg-purple-400 animate-bounce motion-reduce:animate-none [animation-delay:150ms]"></span>
                <span class="h-1.5 w-1.5 rounded-full bg-purple-400 animate-bounce motion-reduce:animate-none [animation-delay:300ms]"></span>
            </span>
            @LoadingHint
        </p>
    </div>
}
else if (Status == ContentStatus.Unavailable)
{
    <Notice Icon="fa-cloud-bolt" Title="@Message" Text="The content service isn't responding at the moment. Please try again in a little while.">
        <Actions>
            <button type="button" class="action-button" @onclick="() => Navigation.Refresh(forceReload: true)">Try again</button>
        </Actions>
    </Notice>
}
else if (Status == ContentStatus.Unreadable)
{
    @* The content itself has a problem, so reloading would show the same: no retry button. *@
    <Notice Icon="fa-file-circle-exclamation" Title="@Message" Text="The published content doesn't fit this page and needs a fix first. Please check back later." />
}

@code {
    /// <summary>Where the page's content is. While loading, a placeholder and hint; when unavailable or unreadable, a notice; otherwise nothing.</summary>
    [Parameter, EditorRequired]
    public ContentStatus Status { get; set; }

    /// <summary>What is being loaded, in the plural or with an article, such as "links" or "the certificate".</summary>
    [Parameter]
    public string Subject { get; set; } = "content";

    /// <summary>The headline shown when the content is unavailable or unreadable.</summary>
    [Parameter]
    public string Message { get; set; } = "This content can't be loaded right now.";

    /// <summary>A placeholder in the shape of the content, shown while it loads.</summary>
    [Parameter]
    public RenderFragment? Placeholder { get; set; }

    private PeriodicTimer? _waitingTimer;
    private int _secondsWaiting;

    // Loading usually takes well under a second; the hint only changes when it doesn't, so visitors know the page isn't stuck.
    private string LoadingHint => _secondsWaiting switch
    {
        < 3 => $"Loading {Subject}…",
        < 8 => "Still loading. The content service is a little slow right now.",
        _ => "This is taking longer than usual. Hang tight, it's still trying.",
    };

    // Each load counts from zero. A page can load again without being recreated (another certificate, say).
    protected override void OnParametersSet()
    {
        if (Status != ContentStatus.Loading)
        {
            StopWaitingTimer();
        }
        else if (_waitingTimer is null)
        {
            _secondsWaiting = 0;
            _waitingTimer = new PeriodicTimer(TimeSpan.FromSeconds(1), Time);
            _ = CountWaitingSecondsAsync(_waitingTimer, Time.GetTimestamp());
        }
    }

    // Measure elapsed time because browsers may throttle background timers.
    private async Task CountWaitingSecondsAsync(PeriodicTimer timer, long loadStarted)
    {
        while (await timer.WaitForNextTickAsync())
        {
            _secondsWaiting = (int)Time.GetElapsedTime(loadStarted).TotalSeconds;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void StopWaitingTimer()
    {
        _waitingTimer?.Dispose();
        _waitingTimer = null;
    }

    public void Dispose() => StopWaitingTimer();
}

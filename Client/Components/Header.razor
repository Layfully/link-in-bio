@using Storyblok.Extensions

@* Full width, so the typed line growing letter by letter never changes the header's size and re-centres the photo. *@
<header class="flex w-full flex-col items-center z-20 @(Reveal ? "reveal" : null)" @attributes="@Model.EditorAttributes()">
    @* Each part renders only when Storyblok has its data, so a header without a photo or link has no empty shapes. *@
    @if (Model?.Profile is { Url.Length: > 0 } profile)
    {
        @* The gradient ring is the wrapper's padding, so photo and ring together stay 128 px, like the placeholder. *@
        <div class="avatar-ring halo size-32 p-[3px]">
            @* Shown at 128 px: Storyblok's image service delivers just the square the circle shows, 128 px or 256 px for
               sharp screens, instead of the original (WebP where the browser takes it). object-cover and
               object-bottom still cut a photo whose address doesn't carry its size. *@
            <img class="size-full rounded-full border-[3px] border-gray-900 bg-gray-900 object-cover object-bottom" src="@profile.SquareFromBottom(128)" srcset="@($"{profile.SquareFromBottom(128)} 1x, {profile.SquareFromBottom(256)} 2x")" width="128" height="128"
                 alt="@(string.IsNullOrWhiteSpace(profile.Alt) ? "Profile picture" : profile.Alt)" fetchpriority="high">
        </div>
    }
    @* The page's heading, visible: search engines weigh the name more as text a visitor sees than as text only screen
       readers get. tabindex lets the app move focus here after a navigation (App.razor); it is never a tab stop. *@
    <h1 class="mt-5 px-6 text-center text-3xl leading-tight font-extrabold tracking-tight text-white outline-none [text-shadow:0_0_24px_rgb(147_51_234/0.45)] sm:text-4xl" tabindex="-1">@Site.Name</h1>
    @if (Model?.ProfileLink is { Url.Length: > 0, Label.Length: > 0 } profileLink)
    {
        <a href="@profileLink.Url" rel="me" class="mt-3 rounded-full border border-purple-400/30 bg-purple-500/10 px-4 py-1 text-sm font-semibold tracking-wide text-purple-200 backdrop-blur-sm transition-colors duration-200 hover:border-purple-300/60 hover:bg-purple-500/20 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-white">@profileLink.Label</a>
    }
    <TypedText Model="@Model?.TypedTexts" />
</header>

@code {
    [Parameter]
    public StoryblokHeader? Model { get; set; }

    /// <summary>Fades the header in. Off when it replaces identical prerendered content, which would otherwise fade in twice.</summary>
    [Parameter]
    public bool Reveal { get; set; } = true;
}

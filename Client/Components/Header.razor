@using Storyblok.Extensions

@* Full width, so the typed line growing letter by letter never changes the header's size and re-centres the photo. *@
<header class="flex w-full flex-col items-center z-20 reveal">
    @* Each part renders only when Storyblok has its data, so a header without a photo or link has no empty shapes. *@
    @if (Model?.Profile is { Url.Length: > 0 } profile)
    {
        @* The gradient ring is the wrapper's padding, so photo and ring together stay 128 px, like the placeholder. *@
        <div class="avatar-ring size-32 p-[3px]">
            @* Shown at 128 px; Storyblok's image service delivers 256 x 384 (2x for sharp screens, the photo's 2:3 ratio) instead of the original. *@
            <img class="size-full rounded-full border-[3px] border-gray-900 bg-gray-900 object-cover object-bottom" src="@profile.Resize(256, 384, smart: false)" width="128" height="128"
                 alt="@(string.IsNullOrWhiteSpace(profile.Alt) ? "Profile picture" : profile.Alt)" fetchpriority="high">
        </div>
    }
    @if (Model?.ProfileLink is { Url.Length: > 0, Label.Length: > 0 } profileLink)
    {
        <a href="@profileLink.Url" rel="me" class="mt-5 rounded-full border border-purple-400/30 bg-purple-500/10 px-4 py-1 text-sm font-semibold tracking-wide text-purple-200 backdrop-blur-sm transition-colors duration-200 hover:border-purple-300/60 hover:bg-purple-500/20 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-white">@profileLink.Label</a>
    }
    <TypedText Model="@Model?.TypedTexts" />
</header>

@code {
    [Parameter]
    public StoryblokHeader? Model { get; set; }
}

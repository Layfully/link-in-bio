@* Placeholder in the shape of the header and link list, shown while the links load. Every box matches the real one
   (Header and LinkList), so nothing moves when the content replaces it. *@
<div class="z-20 flex flex-col items-center w-full" aria-hidden="true">
    <div class="avatar-ring halo size-32 p-[3px]">
        <div class="size-full rounded-full border-[3px] border-gray-900 skeleton"></div>
    </div>

    <div class="mt-5 h-[1.875rem] w-40 rounded-full border border-purple-400/20 skeleton"></div>

    <div class="flex h-32 sm:h-24 items-center">
        <div class="h-7 w-64 max-w-[70vw] rounded-md skeleton"></div>
    </div>

    <ul class="mt-2 flex w-full max-w-md flex-col gap-y-3.5 px-6">
        @for (int i = 0; i < PlaceholderLinks; i++)
        {
            <li class="h-16 rounded-2xl border border-purple-400/15 skeleton"></li>
        }
    </ul>
</div>

@code {
    // The live page currently has four links; the placeholder mirrors that so the layout doesn't jump.
    private const int PlaceholderLinks = 4;
}

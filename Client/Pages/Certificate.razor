@using Storyblok.Extensions
@implements IAsyncDisposable
@inject StoryblokStoryClient StoryblokClient
@inject NavigationManager Navigation
@page "/Certificate/{name}"

<PageTitle>Adrian Gaborek - @Title</PageTitle>
<main class="flex flex-col items-center justify-center bg-gray-900 min-h-screen py-16 overflow-x-clip">
    <h1 class="sr-only" tabindex="-1">Adrian Gaborek - @Title</h1>
    @if (_state is Loaded loaded)
    {
        @* Same card as CertificateSkeleton (width and padding on the outermost element), so nothing moves when the
           certificate replaces the placeholder. width/height let the browser reserve the image's space before it arrives. *@
        <figure class="card z-20 relative w-10/12 sm:w-9/12 xl:w-1/2 p-2 sm:p-3 reveal">
            <img class="block w-full h-auto rounded-xl" src="@loaded.ImageUrl" width="@loaded.Width" height="@loaded.Height"
                 alt="@(loaded.Alt ?? $"Certificate: {loaded.Title}")" fetchpriority="high">
        </figure>
    }
    <StoryblokStatus Status="@ContentStatus" Subject="the certificate"
                     Message="The certificate can't be loaded right now.">
        <Placeholder>
            <CertificateSkeleton />
        </Placeholder>
    </StoryblokStatus>
</main>

@code {
    [Parameter]
    public string? Name { get; set; }

    // The page is in exactly one of these states. Missing hands over to the app's not-found page.
    private union PageState(Loading, Loaded, Unavailable, Missing);
    private sealed record Loading;
    private sealed record Loaded(string Title, string ImageUrl, string? Alt, int? Width, int? Height);
    private sealed record Unavailable;
    private sealed record Missing;

    private PageState _state = new Loading();
    private CancellationTokenSource? _cts;
    private string? _loadedName;

    private ContentStatus ContentStatus => _state switch
    {
        Loading => ContentStatus.Loading,
        Unavailable => ContentStatus.Unavailable,
        _ => ContentStatus.Done,
    };

    private string Title => _state is Loaded loaded ? loaded.Title : "Certificate";

    // Runs again when the address switches to another certificate without recreating the page.
    protected override async Task OnParametersSetAsync()
    {
        if (Name == _loadedName)
        {
            return;
        }

        _loadedName = Name;

        // A previous load still in flight belongs to the old certificate.
        if (_cts is not null)
        {
            await _cts.CancelAsync();
            _cts.Dispose();
        }

        _cts = new CancellationTokenSource();
        CancellationToken cancellationToken = _cts.Token;
        _state = new Loading();

        // The name comes from the address, so it's escaped before it becomes part of the Storyblok request.
        StoryLoadResult<StoryblokCertificate> result = await StoryblokClient.Story()
            .WithSlug($"/certificates/{Uri.EscapeDataString(Name ?? string.Empty)}")
            .ResolveLinks(ResolveLinksType.None)
            .TryLoad<StoryblokCertificate>(cancellationToken);

        if (cancellationToken.IsCancellationRequested)
        {
            return;
        }

        _state = result switch
        {
            // Shown at most about 640 px wide: 1280 px keeps it sharp without downloading the original scan.
            StoryblokStory<StoryblokCertificate> story when story.Content?.Image is { Url.Length: > 0 } image
                => new Loaded(story.Name ?? "Certificate", image.ResizeByWidth(1280) ?? image.Url, image.Alt, image.Dimensions()?.Width, image.Dimensions()?.Height),
            StoryblokStory<StoryblokCertificate> => new Missing(), // published without an image
            StoryNotFound => new Missing(),
            StoryblokUnavailable => new Unavailable(),
            null => new Unavailable(),
        };

        // No certificate (or nothing to show) under this name: show the app's not-found page in place, at the same address.
        if (_state is Missing)
        {
            Navigation.NotFound();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_cts is not null)
        {
            await _cts.CancelAsync();
            _cts.Dispose();
        }
    }
}

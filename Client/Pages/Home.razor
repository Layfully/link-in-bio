@implements IAsyncDisposable
@inject StoryblokStoryClient StoryblokClient
@inject PrerenderedStories Prerendered
@page "/"

<PageTitle>Adrian Gaborek - Links</PageTitle>
@* Each page sets its own canonical address; one in index.html would claim every page is a copy of the home page. *@
<HeadContent>
    <link rel="canonical" href="@($"{Site.Url}/")" />
</HeadContent>
<h1 class="sr-only" tabindex="-1">Adrian Gaborek - Links</h1>
@switch (_state)
{
    case Loaded loaded:
        if (loaded.Header is not null)
        {
            <Header Model="@loaded.Header" Reveal="@loaded.Reveal" />
        }
        if (loaded.Links is { Count: > 0 })
        {
            <LinkList Model="@loaded.Links" Reveal="@loaded.Reveal" />
        }
        break;

    case NothingPublished:
        <Notice Icon="fa-circle-question" Title="Nothing here yet" Text="The links haven't been published yet. Please check back a little later." Kind="NoticeKind.Information" />
        break;
}
<StoryblokStatus Status="@ContentStatus" Subject="links" Message="The links can't be loaded right now.">
    <Placeholder>
        <LinksSkeleton />
    </Placeholder>
</StoryblokStatus>

@code {
    // The page is in exactly one of these states; each state carries only the data it needs.
    private union PageState(Loading, Loaded, Unavailable, Unreadable, NothingPublished);
    private sealed record Loading;
    private sealed record Loaded(StoryblokHeader? Header, IReadOnlyList<StoryblokLink>? Links, bool Reveal);
    private sealed record Unavailable;
    private sealed record Unreadable;
    private sealed record NothingPublished;

    private readonly CancellationTokenSource _cts = new();
    private PageState _state = new Loading();

    private ContentStatus ContentStatus => _state switch
    {
        Loading => ContentStatus.Loading,
        Unavailable => ContentStatus.Unavailable,
        Unreadable => ContentStatus.Unreadable,
        _ => ContentStatus.Done,
    };

    private const string Slug = "/home";

    protected override async Task OnInitializedAsync()
    {
        // The deployed page arrives with its content already in the HTML (see the Prerender project). Its story then
        // loads without a request, so this first render shows the same content, and without fading it in a second time.
        bool prerendered = Prerendered.Contains(Slug);

        // Content that is in the HTML from the start doesn't fade in either: that's the deploy rendering this page right
        // now (IsRecording). Chrome doesn't count an image first painted fully transparent as the largest contentful
        // paint, so a fading photo would make the page's LCP wait for Blazor's copy of it seconds later.
        bool reveal = !prerendered && !Prerendered.IsRecording;

        // Leaving the page cancels the request; Blazor ignores the resulting cancellation.
        StoryLoadResult<StoryblokPage> result = await StoryblokClient.Story()
            .WithSlug(Slug)
            .TryLoad<StoryblokPage>(_cts.Token);

        _state = result switch
        {
            StoryblokStory<StoryblokPage> story => FromBlocks(story.Content.Body, reveal),
            StoryNotFound => new NothingPublished(),
            StoryblokUnavailable => new Unavailable(),
            StoryUnreadable => new Unreadable(),
            null => new Unavailable(),
        };

        if (!prerendered)
        {
            return;
        }

        // The content may have changed in Storyblok since the deploy. Only a newer story replaces it: an outage or an
        // unreadable answer keeps the content the page came with rather than swapping it for an error.
        StoryLoadResult<StoryblokPage>? refreshed = await StoryblokClient.Story()
            .WithSlug(Slug)
            .TryRefresh<StoryblokPage>(_cts.Token);

        if (refreshed?.Value is StoryblokStory<StoryblokPage> newer)
        {
            _state = FromBlocks(newer.Content.Body, reveal: false);
        }
    }

    // Blocks are picked by type, so reordering or adding blocks in Storyblok can't break the page.
    // A story with neither block counts as nothing published, instead of rendering an empty header.
    private static PageState FromBlocks(StoryblokComponent[]? body, bool reveal) =>
        HasContent(body) ? new Loaded(Header(body), Links(body), reveal) : new NothingPublished();

    /// <summary>True when the story has a header or at least one link; otherwise the page says nothing is published yet.</summary>
    public static bool HasContent(StoryblokComponent[]? body) => Header(body) is not null || Links(body) is { Count: > 0 };

    /// <summary>The header the page shows: the story's first header block.</summary>
    public static StoryblokHeader? Header(StoryblokComponent[]? body) => body?.OfType<StoryblokHeader>().FirstOrDefault();

    /// <summary>The links the page lists: those of the story's first list block.</summary>
    public static IReadOnlyList<StoryblokLink>? Links(StoryblokComponent[]? body) =>
        body?.OfType<StoryblokList>().FirstOrDefault()?.EntriesOf<StoryblokLink>();

    public async ValueTask DisposeAsync()
    {
        await _cts.CancelAsync();
        _cts.Dispose();
    }
}

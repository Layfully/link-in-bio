@implements IAsyncDisposable
@inject StoryblokStoryClient StoryblokClient
@page "/"

<PageTitle>Adrian Gaborek - Links</PageTitle>
<main class="flex flex-col items-center justify-center bg-gray-900 min-h-screen">
    <h1 class="sr-only" tabindex="-1">Adrian Gaborek - Links</h1>
    @switch (_state)
    {
        case Loaded loaded:
            if (loaded.Header is not null)
            {
                <Header Model="@loaded.Header" />
            }
            if (loaded.Links is { Count: > 0 })
            {
                <LinkList Model="@loaded.Links" />
            }
            break;

        case NothingPublished:
            <Notice Icon="fa-circle-question" Title="Nothing here yet" Text="The links haven't been published yet. Please check back a little later." Kind="NoticeKind.Information" />
            break;
    }
    <StoryblokStatus Status="@ContentStatus" Subject="links" Message="The links can't be loaded right now.">
        <Placeholder>
            <LinksSkeleton />
        </Placeholder>
    </StoryblokStatus>
</main>

@code {
    // The page is in exactly one of these states; each state carries only the data it needs.
    private union PageState(Loading, Loaded, Unavailable, NothingPublished);
    private sealed record Loading;
    private sealed record Loaded(StoryblokHeader? Header, IReadOnlyList<StoryblokLink>? Links);
    private sealed record Unavailable;
    private sealed record NothingPublished;

    private readonly CancellationTokenSource _cts = new();
    private PageState _state = new Loading();

    private ContentStatus ContentStatus => _state switch
    {
        Loading => ContentStatus.Loading,
        Unavailable => ContentStatus.Unavailable,
        _ => ContentStatus.Done,
    };

    protected override async Task OnInitializedAsync()
    {
        // Leaving the page cancels the request; Blazor ignores the resulting cancellation.
        StoryLoadResult<StoryblokPage> result = await StoryblokClient.Story()
            .WithSlug("/home")
            .ResolveLinks(ResolveLinksType.None)
            .TryLoad<StoryblokPage>(_cts.Token);

        _state = result switch
        {
            StoryblokStory<StoryblokPage> story => FromBlocks(story.Content?.Body),
            StoryNotFound => new NothingPublished(),
            StoryblokUnavailable => new Unavailable(),
            null => new Unavailable(),
        };
    }

    // Blocks are picked by type, so reordering or adding blocks in Storyblok can't break the page.
    // A story with neither block counts as nothing published, instead of rendering an empty header.
    private static PageState FromBlocks(StoryblokComponent[]? body)
    {
        StoryblokHeader? header = body?.OfType<StoryblokHeader>().FirstOrDefault();
        IReadOnlyList<StoryblokLink>? links = body?.OfType<StoryblokList>().FirstOrDefault()?.EntriesOf<StoryblokLink>();

        return header is null && links is not { Count: > 0 } ? new NothingPublished() : new Loaded(header, links);
    }

    public async ValueTask DisposeAsync()
    {
        await _cts.CancelAsync();
        _cts.Dispose();
    }
}

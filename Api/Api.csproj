<Project Sdk="Microsoft.NET.Sdk">
  <!-- The site's API: an Azure Function the Static Web App runs next to the site (managed functions). It passes
       Storyblok's webhook on to GitHub, so a publish starts a deploy (see README, Deployment). -->
  <PropertyGroup>
    <!-- The newest runtime Static Web Apps offers for managed functions (dotnet-isolated:10.0 in staticwebapp.config.json). -->
    <TargetFramework>net10.0</TargetFramework>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Functions types stay out of projects that reference this one (the tests call DeployTrigger directly), where
         their extension classes would clash with others of the same name: compile is private, besides the defaults. -->
    <PackageReference Include="Microsoft.Azure.Functions.Worker" PrivateAssets="compile;contentfiles;analyzers;build" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http" PrivateAssets="compile;contentfiles;analyzers;build" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" />
  </ItemGroup>

  <ItemGroup>
    <None Update="host.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
